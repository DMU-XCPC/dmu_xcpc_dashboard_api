{
  "name": "@dmu/xcpc-api-client",
  "version": "0.1.0",
  "description": "TypeScript client for the DMU/ICPC dashboard REST API. Runs in Node.js and modern browsers with zero runtime dependencies.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fake-indexeddb": "^6.2.5",
    "msw": "^2.15.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
